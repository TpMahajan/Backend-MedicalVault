{
  "name": "app-backend",
  "version": "1.0.0",
  "description": "Secure Node.js backend with MongoDB, JWT auth, and FCM integration",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "build": "node ./scripts/build-check.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "security:audit": "npm audit --omit=dev",
    "security:check": "node --check index.js && npm run security:audit",
    "app-update:metadata": "node ./scripts/update-app-apk-metadata.js",
    "app-update:prepare": "node ./scripts/release-app-update.mjs prepare",
    "app-update:verify-local": "node ./scripts/release-app-update.mjs verify-local",
    "app-update:verify-remote": "node ./scripts/release-app-update.mjs verify-remote",
    "app-update:release": "node ./scripts/release-app-update.mjs release",
    "app-release:build": "node ./scripts/release-app-update.mjs build",
    "app-release:firebase": "node ./scripts/release-app-update.mjs firebase",
    "app-release:complete": "node ./scripts/release-app-update.mjs release --firebase",
    "backup:create": "node ./scripts/backup-db.js",
    "backup:restore": "node ./scripts/restore-db.js",
    "migrate:dedupe-lost-found-matches": "node ./scripts/dedupe-lost-found-matches.js",
    "family-care:backfill": "node ./scripts/family-care/backfill-patient-profiles.js",
    "family-care:verify": "node ./scripts/family-care/verify-backfill.js",
    "family-care:rollback": "node ./scripts/family-care/rollback-backfill.js",
    "family-care:enable-test-entitlement": "node ./scripts/family-care/enable-test-entitlement.js",
    "family-care:migrate-migration-key-index": "node ./scripts/family-care/migrate-care-relationship-migration-key-index.js",
    "guest-sessions:ensure-indexes": "node ./scripts/guest-sessions/ensure-indexes.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.540.0",
    "@aws-sdk/s3-request-presigner": "^3.540.0",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "firebase-admin": "^14.1.0",
    "google-auth-library": "^9.14.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.1",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "multer-s3": "^3.0.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.1",
    "pdf-parse": "^2.3.12",
    "resend": "^6.2.2",
    "sharp": "^0.35.3",
    "tesseract.js": "^6.0.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "firebase-tools": "^15.24.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "@google-cloud/storage": "7.21.0",
    "fast-xml-parser": "5.9.3",
    "gaxios": "7.1.5",
    "js-yaml": "5.1.0",
    "teeny-request": "10.1.3",
    "uuid": "14.0.1",
    "@tootallnate/once": "3.0.1"
  },
  "keywords": [
    "nodejs",
    "express",
    "mongodb",
    "jwt",
    "authentication",
    "fcm",
    "flutter-backend"
  ],
  "author": "Your Name",
  "license": "MIT"
}
