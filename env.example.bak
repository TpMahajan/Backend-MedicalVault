# -------------------- Server --------------------
PORT=5000
NODE_ENV=development
BASE_URL=https://your-backend-url.com
WEB_APP_URL=https://medicalvault-aially.vercel.app
CORS_ORIGINS=https://medicalvault-aially.vercel.app,https://health-vault-web.vercel.app
CORS_ORIGIN_PATTERNS=^https:\\/\\/medicalvault-aially(?:-[a-z0-9-]+)?\\.vercel\\.app$,^https:\\/\\/health-vault-web(?:-[a-z0-9-]+)?\\.vercel\\.app$

# -------------------- Database --------------------
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority&appName=appname

# -------------------- Auth --------------------
JWT_SECRET=replace-with-random-secret-at-least-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace-with-random-refresh-secret-at-least-32-chars-long
# 32-byte encryption key for sensitive profile fields (64 hex chars or base64)
DATA_ENCRYPTION_KEY=replace-with-64-char-hex-key

# -------------------- Guest Clinical Sessions --------------------
# Keep disabled until the web/mobile clients and mail provider are deployed.
GUEST_CLINICAL_SESSIONS_ENABLED=false
GUEST_SESSION_SECRET=replace-with-random-secret-at-least-32-chars-long
GUEST_IP_HMAC_SECRET=replace-with-a-different-random-secret-at-least-32-chars-long
GUEST_INVITATION_MINUTES=10
GUEST_ACTIVE_MINUTES=20
GUEST_MAX_MINUTES=120
GUEST_OTP_MINUTES=5
GUEST_JOIN_MAX_ATTEMPTS=8
GUEST_PUBLIC_RATE_LIMIT_WINDOW_MS=900000
GUEST_PUBLIC_RATE_LIMIT_MAX=30
# Configure only the actual ingress/load-balancer hops; never trust arbitrary
# X-Forwarded-For headers from the public internet.
TRUST_PROXY_HOPS=1

# -------------------- SuperAdmin --------------------
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_BOOTSTRAP_PASSWORD=replace-with-strong-temporary-bootstrap-password

# -------------------- Uploads --------------------
UPLOAD_DIR=uploads
# Local /uploads fallback when S3 is unavailable. Unset = allowed only when
# NODE_ENV != production. In production without S3, uploads fail with 503
# instead of silently storing sensitive files in public local storage.
# ALLOW_LOCAL_UPLOAD_FALLBACK=false

# -------------------- AWS S3 --------------------
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=your-s3-bucket-name

# -------------------- Firebase Admin SDK (for FCM) --------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<replace-with-private-key>\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-fbsvc%40medicalvaultnotifications.iam.gserviceaccount.com

# -------------------- Rate Limiting --------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# -------------------- Google Places / Nearby --------------------
GOOGLE_PLACES_API_KEY=
NEARBY_PLACES_TIMEOUT_MS=5000

# -------------------- AI Governance --------------------
OPENAI_API_KEY=
AI_ASSISTANT_ENABLED=true
AI_DOCUMENT_VERIFICATION_ENABLED=true
AI_DEFAULT_MODEL=gpt-4o-mini
AI_ALLOWED_MODELS=gpt-4o-mini
AI_MAX_INPUT_CHARS=6000
AI_MAX_INPUT_TOKENS=1500
AI_MAX_OUTPUT_TOKENS=700
AI_MAX_CHAT_HISTORY_MESSAGES=6
AI_MAX_DOCUMENTS_PER_REQUEST=3
AI_DAILY_PATIENT_MESSAGE_LIMIT=10
AI_DAILY_DOCTOR_MESSAGE_LIMIT=25
AI_DAILY_ADMIN_MESSAGE_LIMIT=50
AI_DAILY_GLOBAL_TOKEN_BUDGET=100000
AI_DAILY_GLOBAL_COST_BUDGET=10

# -------------------- Document Verification --------------------
DOCUMENT_VALIDATION_PDF_PAGES=1
DOCUMENT_VALIDATION_MAX_TEXT_CHARS=3000
DOCUMENT_CLASSIFIER_TIMEOUT_MS=5000
DOCUMENT_OCR_TIMEOUT_MS=7000
ALLOW_INCONCLUSIVE_MEDICAL_UPLOADS=true

# -------------------- Cloudinary (Legacy - can be removed) --------------------
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
